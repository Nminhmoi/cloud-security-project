# Sao chép tệp này thành .env và thay giá trị bằng một chuỗi bí mật ngẫu nhiên dài.
SECRET_KEY=replace-with-a-long-random-secret
APP_PORT=5000
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=16777216
USER_STORAGE_QUOTA_BYTES=524288000
DELETED_DOCUMENT_RETENTION_DAYS=30
MAX_ARCHIVE_MEMBERS=1000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=134217728
MAX_ARCHIVE_COMPRESSION_RATIO=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,csv,png,jpg,jpeg,docx,xlsx,pptx,zip
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
MIN_PASSWORD_LENGTH=12
OTP_DELIVERY_MODE=local
AWS_REGION=ap-southeast-1
AWS_SES_SENDER=

# Cấu hình MySQL cho Docker Compose. Dùng các mật khẩu dài, khác nhau khi triển khai thực tế.
DB_HOST=db
DB_PORT=3306
DB_NAME=cloudbox
DB_USER=cloudbox
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306
SECONDARY_APP_PORT=5001

# Khi chạy Python trực tiếp, mặc định vẫn dùng database.db nếu không khai báo
# DATABASE_URL và DB_HOST. Amazon RDS có thể dùng các biến DB_* ở trên hoặc:
# DATABASE_URL=mysql+pymysql://cloudbox_user:password@rds-endpoint:3306/cloudbox?charset=utf8mb4
# AUTO_CREATE_SCHEMA=false
