# Copy this file to .env and replace the value with a long random secret.
SECRET_KEY=replace-with-a-long-random-secret
APP_PORT=5000
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=16777216
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,csv,png,jpg,jpeg,docx,xlsx,pptx,zip
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Docker Compose MySQL settings. Use long, different passwords in production.
DB_HOST=db
DB_PORT=3306
DB_NAME=cloudbox
DB_USER=cloudbox
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306
SECONDARY_APP_PORT=5001

# Running Python directly still defaults to database.db when DATABASE_URL and
# DB_HOST are omitted. Amazon RDS can use either the DB_* settings above or:
# DATABASE_URL=mysql+pymysql://cloudbox_user:password@rds-endpoint:3306/cloudbox?charset=utf8mb4
# AUTO_CREATE_SCHEMA=false
