# Mã bytecode và bộ nhớ đệm Python
__pycache__/
*.py[cod]

# Các môi trường Python cục bộ
.venv/
venv/

# Cơ sở dữ liệu khi chạy ứng dụng
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db.*backup*

# Kế hoạch Terraform có thể chứa thông tin hạ tầng và giá trị được tạo từ dữ liệu bí mật
*.tfplan
tfplan
tfplan.*
*.tfvars
*.tfvars.json
!*.tfvars.example
backups/

# Dữ liệu người dùng tải lên khi ứng dụng hoạt động
app/uploads/

# Thông tin bí mật và cấu hình cục bộ
.env
.env.*
!.env.example

# File tạm khi biên dịch báo cáo; PDF hoàn chỉnh vẫn được lưu trong Git
docs/reports/build/
docs/reports/evidence/originals/
docs/reports/*.aux
docs/reports/*.log
docs/reports/*.toc
docs/reports/*.lof
docs/reports/*.lot
docs/reports/*.out
docs/reports/*.fls
docs/reports/*.fdb_latexmk
docs/reports/*.synctex.gz
